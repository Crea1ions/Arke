# Environment Variables for Arke
# Copy this file to .env and fill in your values
# .env is gitignored and not tracked by Git

# ============================================================================
# LLM API Keys (required for agent cognition)
# ============================================================================

# Google Gemini (recommended for cost/speed)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Mistral AI (optional fallback)
# Get key: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Anthropic Claude (optional fallback)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter (optional fallback, supports many models)
# Get key: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ============================================================================
# Telegram Bot (optional, for Telegram interface)
# ============================================================================

# Get token from @BotFather on Telegram: /newbot
# Format: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ============================================================================
# Logging & Debugging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (verbose output)
DEBUG=false

# ============================================================================
# Cache & Performance
# ============================================================================

# Prevents 25s HTTP call on litellm startup (GitHub model cost map fetch: 25s → 3.7s)
LITELLM_LOCAL_MODEL_COST_MAP=True

# LLM response cache TTL (seconds)
CACHE_TTL=3600

# Vector embedding cache TTL (seconds)
EMBEDDING_CACHE_TTL=86400

# ============================================================================
# Sandbox & Security
# ============================================================================

# Enable bubblewrap sandbox (safer, may be slower)
SANDBOX_ENABLED=true

# Read-only filesystem in sandbox
SANDBOX_READONLY=true

# ============================================================================
# Telemetry & Monitoring (advanced, optional)
# ============================================================================

# Enable OpenTelemetry tracing
TELEMETRY_ENABLED=false

# OTLP HTTP endpoint (if telemetry enabled)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================================
# Development (internal use only)
# ============================================================================

# Enable development mode
ARKE_DEV=false

# Model override for testing
ARKE_MODEL_OVERRIDE=

# Database path override
ARKE_MEMORY_PATH=./memory
